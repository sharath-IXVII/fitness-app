rules_version = '2';

// Fit Tracker: who can read and write what. Deploy with
//   firebase deploy --only firestore:rules
// or paste into Firebase console → Firestore → Rules.
// Tested in firebase-tests/ (npm test runs them on the emulator).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function data() { return request.resource.data; }
    function changes() { return data().diff(resource.data).affectedKeys(); }
    function blockedEither(a, b) {
      return exists(/databases/$(database)/documents/users/$(a)/blocked/$(b))
        || exists(/databases/$(database)/documents/users/$(b)/blocked/$(a));
    }
    function shortText(v, max) { return v is string && v.size() > 0 && v.size() <= max; }
    function optText(v, max) { return v == null || shortText(v, max); }
    function smallInt(v, max) { return v is int && v >= 0 && v <= max; }

    // Both sides of a friendship are written once their challenge is done,
    // and never while either has blocked the other.
    function challengeDoneBetween(id, a, b) {
      let c = get(/databases/$(database)/documents/challenges/$(id)).data;
      return c.status == 'done'
        && ((c.fromUid == a && c.toUid == b) || (c.fromUid == b && c.toUid == a))
        && !blockedEither(a, b);
    }

    // ---------------------------------------------------- public profiles
    function validProfile() {
      let d = data();
      return d.keys().hasOnly(['name', 'title', 'titleTier', 'titleSeason', 'level', 'xp', 'streak', 'bestStreak',
                               'arcLabel', 'arcActive', 'workoutsWeek', 'updatedAt'])
        && shortText(d.name, 40)
        && optText(d.get('title', null), 60)
        && (d.get('titleTier', null) == null || smallInt(d.titleTier, 2))
        && optText(d.get('titleSeason', null), 20)
        && smallInt(d.level, 1000)
        && smallInt(d.xp, 10000000)
        && smallInt(d.streak, 100000)
        && smallInt(d.bestStreak, 100000)
        && d.arcLabel is string && d.arcLabel.size() <= 40
        && smallInt(d.arcActive, 100)
        && smallInt(d.workoutsWeek, 1000)
        && d.updatedAt == request.time;
    }

    match /users/{uid} {
      // Fetch one profile by id; no listing everyone.
      allow get: if signedIn();
      allow create: if me() == uid && validProfile() && data().xp <= 200000;
      // XP is worked out on the phone; cap how fast it can grow (a real day
      // earns well under 200) so the leaderboard can't be pumped.
      allow update: if me() == uid && validProfile() && data().xp <= resource.data.xp + 2000;
      allow delete: if me() == uid;

      // Private progress backup (per day, plus profile and badges). Only the
      // owner can read or write it; sizes are bounded.
      match /days/{day} {
        allow read, delete: if me() == uid;
        allow create, update: if me() == uid
          && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && data().keys().hasOnly(['workout', 'water', 'steps', 'meals', 'protein'])
          && data().workout is bool
          && smallInt(data().water, 20000)
          && smallInt(data().steps, 200000)
          && smallInt(data().meals, 50)
          && smallInt(data().protein, 2000);
      }

      match /backup/{doc} {
        allow read, delete: if me() == uid;
        allow create, update: if me() == uid
          && doc == 'state'
          && data().keys().hasOnly(['profile', 'badges', 'firstUse', 'waterGoal', 'updatedAt'])
          && data().profile is map
          && data().badges is map
          && data().badges.size() <= 100
          && data().firstUse is string && data().firstUse.size() == 10
          && (data().get('waterGoal', null) == null || (data().waterGoal is int && data().waterGoal >= 500 && data().waterGoal <= 8000))
          && data().updatedAt == request.time;
      }

      match /friends/{fid} {
        allow read: if me() == uid || me() == fid;
        allow create, update: if (me() == uid || me() == fid)
          && data().keys().hasOnly(['since', 'via'])
          && (
            // Finished a challenge together.
            challengeDoneBetween(data().via, uid, fid)
            // Or one asked and the other accepted: each side is written by
            // the person who received the request (before it is deleted).
            || (data().via == 'request' && data().since is int && !blockedEither(uid, fid)
                && ((me() == uid && exists(/databases/$(database)/documents/users/$(uid)/requests/$(fid)))
                    || (me() == fid && exists(/databases/$(database)/documents/users/$(fid)/requests/$(uid)))))
          );
        allow delete: if me() == uid || me() == fid;
      }

      // Friend requests land in the inbox of the person asked. Only the
      // asker writes one (one per asker), never to themselves or to someone
      // who blocked them. The person asked, and the asker, can read and
      // remove it.
      match /requests/{from} {
        allow create: if me() == from && me() != uid && !blockedEither(from, uid)
          && data().keys().hasOnly(['name', 'title', 'at'])
          && shortText(data().name, 40) && optText(data().get('title', null), 60)
          && data().at == request.time;
        allow get, delete: if me() == uid || me() == from;
        allow list: if me() == uid;
      }

      // The clubs this user is in (their own list).
      match /clubs/{club} {
        allow read, delete: if me() == uid;
        allow create, update: if me() == uid
          && data().keys().hasOnly(['name', 'kind'])
          && shortText(data().name, 40) && data().kind is string && data().kind.size() <= 20;
      }

      // You can see whether someone blocked you, nothing else.
      match /blocked/{other} {
        allow get: if me() == uid || me() == other;
        allow list, write: if me() == uid;
      }
    }

    // -------------------------------------------------------- challenges
    function validNewChallenge() {
      let d = data();
      return d.keys().hasOnly(['code', 'fromUid', 'fromName', 'fromTitle', 'toUid', 'toName', 'toTitle', 'exercise',
                               'reps', 'arcLabel', 'status', 'fromDone', 'toDone', 'createdAt'])
        && d.fromUid == me()
        && d.code is string && d.code.matches('^[A-HJKMNP-Z2-9]{6}$')
        && shortText(d.fromName, 40) && optText(d.fromTitle, 60)
        && optText(d.toName, 40) && optText(d.toTitle, 60)
        && d.exercise in ['pushUp', 'squat', 'sitUp', 'jumpingJack', 'lunge', 'burpee', 'plank', 'highKnees']
        && d.reps is int && d.reps > 0 && d.reps <= 300
        && d.arcLabel is string && d.arcLabel.size() <= 40
        && d.createdAt is int
        && d.fromDone == false && d.toDone == false;
    }

    match /challenges/{id} {
      function isParty() { return resource.data.fromUid == me() || resource.data.toUid == me(); }

      // Open ones can be fetched by id (after a code lookup), never listed.
      allow get: if signedIn() && (resource.data.status == 'open' || isParty());
      allow list: if signedIn() && isParty();

      allow create: if signedIn() && validNewChallenge() && (
          // Open, for anyone with the code.
          (data().status == 'open' && data().toUid == null && data().toName == null)
          // Straight to a friend who hasn't blocked you.
          || (data().status == 'accepted' && data().toUid is string
              && exists(/databases/$(database)/documents/users/$(me())/friends/$(data().toUid))
              && !blockedEither(me(), data().toUid))
        );

      allow update: if signedIn() && (
        // Join an open challenge (not your own, not someone who blocked you).
        (resource.data.status == 'open' && resource.data.toUid == null && resource.data.fromUid != me()
          && !blockedEither(me(), resource.data.fromUid)
          && changes().hasOnly(['toUid', 'toName', 'toTitle', 'status'])
          && data().toUid == me() && data().status == 'accepted'
          && shortText(data().toName, 40) && optText(data().toTitle, 60))
        // The challenger marks their part done.
        || (resource.data.fromUid == me() && resource.data.status == 'accepted'
          && changes().hasOnly(['fromDone', 'status']) && data().fromDone == true
          && (data().status == 'accepted' || (data().status == 'done' && resource.data.toDone == true)))
        // The friend marks their part done.
        || (resource.data.toUid == me() && resource.data.status == 'accepted'
          && changes().hasOnly(['toDone', 'status']) && data().toDone == true
          && (data().status == 'accepted' || (data().status == 'done' && resource.data.fromDone == true)))
        // Either side declines one that isn't finished.
        || (isParty() && resource.data.status in ['open', 'accepted']
          && changes().hasOnly(['status']) && data().status == 'declined')
      );

      // Either side can delete (account deletion).
      allow delete: if signedIn() && isParty();
    }

    // Friend codes: a short code you can give someone so they can send you a
    // friend request. Looked up one at a time; you can find your own.
    match /friendCodes/{code} {
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.uid == me();
      allow create: if signedIn() && code.matches('^[A-HJKMNP-Z2-9]{6}$')
        && data().keys().hasOnly(['uid']) && data().uid == me();
      allow delete: if signedIn() && resource.data.uid == me();
    }

    // Share codes: looked up one at a time by the person given the code.
    match /codes/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && data().keys().hasOnly(['challengeId', 'fromUid'])
        && data().fromUid == me()
        && getAfter(/databases/$(database)/documents/challenges/$(data().challengeId)).data.fromUid == me()
        && getAfter(/databases/$(database)/documents/challenges/$(data().challengeId)).data.code == code;
      allow delete: if signedIn() && resource.data.fromUid == me();
    }

    // ------------------------------------------------------------- clubs
    // Same pattern as containsLink() in lib/features/clubs/domain/club.dart.
    function noLink(v) {
      return !v.lower().matches('(?s).*(https?://|www[.]|wa[.]me|t[.]me|[a-z0-9-]+[.](com|in|net|org|io|co|me|ly|app|xyz|link|gg|info|biz|online|site|shop|club|tv|to)([^a-z0-9].*|$)).*');
    }
    function clubDoc(c) { return get(/databases/$(database)/documents/clubs/$(c)).data; }
    function isMember(c) { return exists(/databases/$(database)/documents/clubs/$(c)/members/$(me())); }
    function ownsClub(c) { return clubDoc(c).ownerUid == me(); }

    match /clubs/{club} {
      // Anyone signed in can browse clubs.
      allow read: if signedIn();
      allow create: if signedIn()
        && data().keys().hasOnly(['name', 'about', 'kind', 'ownerUid', 'ownerName', 'createdAt'])
        && data().ownerUid == me()
        && data().name is string && data().name.size() >= 3 && data().name.size() <= 40 && noLink(data().name)
        && data().about is string && data().about.size() <= 200 && noLink(data().about)
        && data().kind in ['gym', 'running', 'walking', 'cycling', 'yoga', 'sports', 'diet', 'other']
        && shortText(data().ownerName, 40)
        && data().createdAt == request.time;
      allow delete: if signedIn() && resource.data.ownerUid == me();

      match /members/{uid} {
        allow read: if signedIn();
        // Join yourself, unless the owner removed you.
        allow create: if me() == uid
          && !exists(/databases/$(database)/documents/clubs/$(club)/banned/$(uid))
          && data().keys().hasOnly(['name', 'joinedAt'])
          && shortText(data().name, 40) && data().joinedAt == request.time;
        allow delete: if me() == uid || ownsClub(club);
      }

      match /banned/{uid} {
        allow get: if me() == uid || ownsClub(club);
        allow create: if ownsClub(club) && uid != me() && data().keys().hasOnly(['at']);
      }

      // Members only. Text with no links, gone after 24 hours: the app shows
      // only the last day, and a TTL policy on expireAt deletes them.
      match /messages/{msg} {
        allow read: if isMember(club);
        allow create: if isMember(club)
          && data().keys().hasOnly(['uid', 'name', 'text', 'at', 'expireAt'])
          && data().uid == me()
          && shortText(data().name, 40)
          && shortText(data().text, 500) && noLink(data().text)
          && data().at == request.time
          && data().expireAt is timestamp
          && data().expireAt > request.time + duration.value(23, 'h')
          && data().expireAt < request.time + duration.value(25, 'h');
        allow delete: if signedIn() && (resource.data.uid == me() || ownsClub(club));
      }

      // Challenges the club admin sets ("Run 8 km from the lake gate").
      match /challenges/{ch} {
        allow read: if isMember(club);
        allow create: if ownsClub(club)
          && data().keys().hasOnly(['title', 'kind', 'distanceM', 'startsAt', 'endsAt', 'start', 'finish', 'plan', 'startName',
                                    'createdBy', 'createdAt'])
          && data().createdBy == me()
          && data().title is string && data().title.size() >= 3 && data().title.size() <= 60 && noLink(data().title)
          && data().kind in ['run', 'walk', 'cycle']
          && data().distanceM is int && data().distanceM >= 500 && data().distanceM <= 100000
          && data().startsAt is timestamp && data().endsAt is timestamp
          && data().endsAt > data().startsAt
          && data().endsAt <= data().startsAt + duration.value(31, 'd')
          && (data().get('start', null) == null || data().start is latlng)
          && (data().get('finish', null) == null || data().finish is latlng)
          && (data().get('plan', null) == null || (data().plan is list && data().plan.size() <= 200))
          && data().startName is string && data().startName.size() <= 40 && noLink(data().startName)
          && data().createdAt == request.time;
        allow delete: if ownsClub(club);

        // One best finish per member. The time must be humanly possible for
        // the activity (run 25 km/h, walk 9, cycle 60 on average), and only
        // a faster time replaces an earlier one.
        match /results/{uid} {
          function challenge() { return get(/databases/$(database)/documents/clubs/$(club)/challenges/$(ch)).data; }
          function maxKmh(kind) { return kind == 'run' ? 25 : (kind == 'walk' ? 9 : 60); }
          function validResult() {
            let c = challenge();
            return data().keys().hasOnly(['name', 'timeMs', 'distanceM', 'at'])
              && shortText(data().name, 40)
              && data().distanceM is int && data().distanceM >= c.distanceM && data().distanceM <= c.distanceM * 2
              && data().timeMs is int && data().timeMs * maxKmh(c.kind) >= data().distanceM * 3600
              && data().at == request.time
              && request.time >= c.startsAt && request.time <= c.endsAt + duration.value(6, 'h');
          }
          allow read: if isMember(club);
          allow create: if me() == uid && isMember(club) && validResult();
          allow update: if me() == uid && isMember(club) && validResult() && data().timeMs < resource.data.timeMs;
          allow delete: if me() == uid || ownsClub(club);
        }
      }
    }

    // App settings the owner edits in the console (festival dates).
    match /config/{doc} {
      allow read: if true;
    }

    // Reports of abuse: write-only, reviewed in the console.
    match /reports/{id} {
      allow create: if signedIn() && data().by == me() && data().about is string
        && data().reason is string && data().reason.size() <= 500;
    }
  }
}
